<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/more_edit_width"
    android:layout_height="wrap_content">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="15.33dp"
        android:layout_gravity="end"
        android:layout_marginEnd="7dp"
        android:elevation="2dp"
        android:src="@drawable/ic_triangle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/renameTv"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_more_edit_top_corner"
        android:elevation="2dp"
        android:gravity="center_vertical|start"
        android:paddingStart="10.67dp"
        android:text="@string/rename"
        android:textColor="@color/black_333333"
        android:textSize="10.67sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="RtlSymmetry" />

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="6dp"
        android:background="@color/gray_EEEEEE"
        android:gravity="center_vertical|start"
        app:layout_constraintTop_toBottomOf="@+id/renameTv" />

    <TextView
        android:id="@+id/deleteTv"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/bg_more_edit_bottom_corner"
        android:elevation="2dp"
        android:gravity="center_vertical|start"
        android:paddingStart="10.67dp"
        android:text="@string/delete"
        android:textColor="@color/black_333333"
        android:textSize="10.67sp"
        app:layout_constraintTop_toBottomOf="@+id/line" />

</androidx.constraintlayout.widget.ConstraintLayout>